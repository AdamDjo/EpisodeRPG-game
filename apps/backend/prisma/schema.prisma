// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// ---------------------------------------------------------------------------
// Vision domaine complète (voir docs/canon/*.md) — NON migrée ici :
// Peuples, Vocations (catalogues statiques, pas de table), Factions/réputation,
// Quêtes, Inventaire/Items complet, Traces, World Events. Ces modèles
// arriveront avec les écrans qui en ont besoin (World Map, inventaire complet).
//
// Migré aujourd'hui (coeur du world-state de session + méta) : User, Character
// (avec fer et topics vus de l'Aveugle), GameSession, SceneLog, MemoryChunk,
// Souvenir (anonyme ou nommé), Chronicle.
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String      @id
  email      String      @unique
  /// Compteur lifetime des requêtes de jeu en tant qu'utilisateur anonyme (cap = 30).
  anonymousRequestCount Int @default(0)
  /// Préférence de langue de narration IA explicitement choisie par le joueur
  /// (tag BCP-47 normalisé). Null tant qu'aucun choix explicite : on retombe
  /// alors sur la locale navigateur puis l'anglais (#168).
  preferredLocale String?
  createdAt  DateTime    @default(now())
  characters Character[]
  souvenirs  Souvenir[]
  chronicles Chronicle[]
}

model Character {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  people    String
  vocation  String
  /// Concept libre saisi par le joueur quand vocation = "libre".
  freeConcept String?
  backstory   String?
  avatarUrl   String?

  /// Nom de vocation personnalisé par L'Aveugle quand `vocation` a été
  /// résolue depuis un concept libre. @see docs/canon/07-CHARACTER-CREATION.md §2
  customVocationName String?
  /// Trait narratif attribué par L'Aveugle lors de la résolution du concept libre.
  narrativeTrait     String?
  /// Compétences canon de la vocation renommées pour coller au concept libre
  /// (ShiftedSkill[] JSON), voir @grimoire/shared.
  shiftedSkills      Json?   @default("[]")

  // Triptyque canon SANG/SOUFFLE/VOLONTÉ (3-18).
  blood  Int
  breath Int
  will   Int

  // Jauges de survie (0-100), voir SurvivalStats.
  hp       Int
  maxHp    Int
  thirst   Int
  hunger   Int
  energy   Int
  calamine Int

  /// True after the first 0-HP hit: one telegraphed turn of reprieve before a
  /// second 0-HP hit is definitive death. @see docs/canon/06-SURVIVAL.md §7
  isDying Boolean @default(false)

  /// Consecutive turns thirst or hunger has been at 0 — drives the prolonged
  /// neglect Calamine source. Resets once both gauges are back above 0.
  neglectStreak Int @default(0)

  /// Charges d'Emprise actuelles (forcer le monde), dérivées du mod VOLONTÉ.
  /// @see docs/canon/04-ATTRIBUTES.md "Les charges d'Emprise"
  empriseCharges Int @default(0)

  /// États altérés persistants (ActiveCondition[] JSON), voir @grimoire/shared.
  /// @see docs/canon/06-SURVIVAL.md §2
  activeConditions Json @default("[]")

  /// Inventaire réel (PersistedInventoryItem[] JSON), voir @grimoire/shared.
  /// @see docs/canon/11-INVENTORY-ECONOMY.md §1
  inventory Json @default("[]")

  /// Or (🪙), monnaie in-game de Velkhar. Gagné au combat (butin des corps,
  /// `goldGained`) et dépensé au Comptoir (#249).
  gold Int @default(0)

  /// Ids des topics du catalogue statique de L'Aveugle déjà vus par ce joueur
  /// (le contenu des topics reste statique côté frontend, seul l'état "vu" persiste).
  aveugleSeenTopics String[] @default([])

  createdAt DateTime @default(now())
  sessions  GameSession[]
  counterPurchases CounterPurchase[]

  /// One character per user for now (no multi-character roster yet) — also
  /// closes the createCharacter() findFirst/create race condition.
  @@unique([userId])
}

/// Une transaction du Comptoir (#249), persistée pour la rendre idempotente et
/// rejouable. La ligne n'existe que si l'achat a été *accepté* : un refus ne
/// consomme pas le `purchaseId`, pour que le joueur puisse corriger son panier
/// et réessayer avec le même id.
/// @see docs/canon/11-INVENTORY-ECONOMY.md §2
model CounterPurchase {
  id          String    @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  /// Id fourni par le client. Unique *par personnage* : deux joueurs peuvent
  /// générer le même uuid sans se bloquer mutuellement, et c'est cette
  /// contrainte que la transaction concurrente heurte (P2002) pour garantir
  /// qu'un double envoi ne débite le fer qu'une fois.
  purchaseId String

  /// Lignes achetées (CounterPurchaseLine[] JSON), voir @grimoire/shared.
  lines Json

  /// Fer débité et solde restant au moment de l'achat — la réponse rejouée est
  /// reconstruite depuis ces valeurs, jamais recalculée sur l'état courant.
  totalGold  Int
  goldAfter  Int

  createdAt DateTime @default(now())

  @@unique([characterId, purchaseId])
}

model GameSession {
  id          String   @id @default(uuid())
  characterId String
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  turnNumber Int      @default(1)
  location   String   @default("auberge-aveugle")
  /// Langue de narration IA résolue à la création de la session (tag BCP-47
  /// normalisé). Persistée pour que la reprise garde la même langue (#168).
  locale     String   @default("en")
  status     String   @default("active") // active | ended
  /// Why the session ended (death | extracted | returned_empty | abandon | calcined).
  /// Null while active. Bridge to A3. @see docs/canon/23-RUN-STRUCTURE.md §5
  endReason  String?
  /// URL résolue du cache d'images de scène partagé (#207), mise à jour à
  /// chaque compression N2. Null tant qu'aucun chunk n'a encore résolu d'image.
  currentImageUrl String?

  // --- Structure de run (#228) — @see docs/canon/23-RUN-STRUCTURE.md
  /// Mode de jeu courant (inn | exploration | combat | return). Une session
  /// commence à l'auberge : c'est là qu'on accepte un contrat.
  gameMode          String   @default("inn")
  /// Contrat accepté. Null tant que le joueur n'est pas parti — et sur toutes
  /// les sessions antérieures à #228, qui restent jouables sans structure de run.
  contractId        String?
  /// Famille de quête (dungeon | escort | investigation | hunt | recovery |
  /// negotiation | dilemma). Seule `dungeon` descend : c'est elle qui décide si
  /// `contractTargetDepth` a un sens (#260).
  contractFamily      String?
  contractDestination String?
  /// Commanditaire : qui a posé le contrat, et qui paie au retour.
  contractCommissioner String?
  /// Tag de danger affiché sur le tableau (easy | medium | hard). Le chiffrage
  /// qui le produit reste interne et n'est jamais envoyé au client.
  contractDanger      String?
  /// Tag de durée affiché (short | long | major). Les minutes restent internes.
  contractDuration    String?
  /// Intensité du contrat (3 | 5 | 7) : l'unité universelle de longueur, portée
  /// par toutes les familles (#269). Null sur les lignes antérieures, relues
  /// depuis `contractTargetDepth` pour un donjon et depuis le tag de durée
  /// sinon. Jamais projetée telle quelle au client.
  contractIntensity   Int?
  /// Profondeur visée (3 | 5 | 7) : la lecture donjon de `contractIntensity`.
  /// Null pour toute quête non-donjon — une escorte n'a pas de paliers, et
  /// aucune règle n'a le droit de lui en inventer.
  contractTargetDepth Int?
  /// Fer payé par le commanditaire au retour, si le joueur revient.
  contractRewardGold  Int?
  contractObjective   String?
  /// Ce que le backend vérifie pour déclarer le contrat rempli.
  contractSuccessCondition String?
  /// Toutes les façons de perdre le contrat. Vide = seule la mort le fait échouer.
  contractFailureConditions String[] @default([])
  /// Palier courant. 0 = en surface (auberge ou sorti du donjon).
  currentDepth      Int      @default(0)
  /// Palier le plus profond atteint ce run. Ne redescend jamais — c'est lui qui
  /// décrit ce que le joueur a réellement osé.
  maxDepthReached   Int      @default(0)
  /// Salle en cours de résolution, null entre deux salles.
  currentRoomId     String?
  /// True une fois le demi-tour engagé. Irréversible : on ne redescend plus.
  returnEngaged     Boolean  @default(false)
  /// True quand l'objectif du contrat est sécurisé. Décide `extracted` vs
  /// `returned_empty` au retour.
  objectiveSecured  Boolean  @default(false)

  // --- Combat par tours (#235) — @see docs/canon/10-COMBAT.md
  /// État complet du combat en cours, sérialisé. Null hors combat — c'est ce
  /// null qui dit « pas de combat », jamais un `gameMode` désynchronisé.
  /// Persisté en entier (initiative, round, camp actif, PV et conditions de
  /// chaque ennemi) pour qu'une reprise de session retrouve la rencontre
  /// exactement dans l'état où elle a été quittée, sans rejouer un seul dé.
  combatState       Json?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  scenes        SceneLog[]
  memoryChunks  MemoryChunk[]
}

model SceneLog {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  turnNumber Int
  sceneType  String
  location   String
  narrative  String
  /// Condensé factuel court (<=200 car.) du tour, généré par l'IA — alimente la fenêtre N1.
  turnSummary String?
  /// Choix proposés au joueur pour ce tour (Choice[] sérialisé).
  choices    Json
  /// Choix effectivement pris par le joueur (Choice | null).
  chosenChoice Json?
  /// Conséquences appliquées (ChoiceConsequence | null).
  consequences Json?
  /// Jet de dés serveur pour ce tour, si applicable (DiceRoll | null).
  diceRoll   Json?
  source     String // "ai" | "stub"

  createdAt DateTime @default(now())
}

model MemoryChunk {
  id        String      @id @default(uuid())
  sessionId String
  session   GameSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  /// Résumé narratif à la 3e personne (~150 tokens max).
  summary   String
  /// Faits clés du segment compressé (String[] sérialisé, 3-5 items).
  keyFacts       Json
  /// Sous-ensemble de faits critiques épinglés (mort PNJ, artefact, quête, choix moral).
  keyFactsPinned Json
  /// Ambiance dominante du segment : calm | tense | festive | sacred | dangerous.
  mood           String
  /// Évolution des PNJ croisés (NpcEvolution[] sérialisé).
  npcsEvolution  Json

  turnRangeStart Int
  turnRangeEnd   Int

  createdAt DateTime @default(now())
}

/// Bibliothèque d'images de scène partagée entre tous les joueurs (#207).
/// Une ligne par combinaison sceneType_depthBand_lieuType rencontrée ; générée une
/// seule fois puis réutilisée par tous les chunks qui matchent la même clé.
/// @see docs/tech/SCENE_IMAGES.md
model SceneImage {
  id        String   @id @default(uuid())
  cacheKey  String   @unique
  url       String
  createdAt DateTime @default(now())
}

/// Named Souvenir (N3 inter-run memory, #115). Cross-run and permanent —
/// linked to `User` only (no cascade relation to Session/Character, which
/// must be free to disappear while the Souvenir survives them). `characterId`
/// and `sessionId` are kept as plain strings for provenance/display only.
model Souvenir {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  sessionId   String

  title String
  body  String
  /// SouvenirType (@grimoire/shared) stored as a plain string, matching
  /// SceneLog.sceneType's convention — no Prisma enum in this schema.
  type  String

  /// True for an anonymous Souvenir (generic lore fragment, spendable as
  /// currency with L'Aveugle — 11-INVENTORY-ECONOMY.md §3). False (default)
  /// for a named Souvenir (a specific marked act of the player, narrative
  /// only, never spendable). The player-facing word "Souvenir" covers both
  /// sub-types on purpose (canon); this flag is the only backend distinction.
  anonymous Boolean @default(false)

  /// True once this Souvenir has been spent with L'Aveugle in exchange for
  /// lore (#147). Only ever set on an anonymous Souvenir.
  sharedWithAveugle Boolean @default(false)
  /// AI-generated lore text produced when this Souvenir was spent, kept for
  /// display history. Null until `sharedWithAveugle` is set to true.
  aveugleLoreResult String?

  createdAt DateTime @default(now())
}

/// End-of-run literary synthesis (#116). One-time, generated when a
/// GameSession ends (death | inn | abandon). Linked to `User` only (no
/// cascade relation to Session/Character, which must be free to disappear
/// while the Chronicle survives them, mirroring `Souvenir`). `characterId`
/// and `sessionId` are kept as plain strings for provenance/display only.
/// No slug/public-URL field yet — public sharing is a deferred, separate ticket.
model Chronicle {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  characterId String
  sessionId   String

  /// Why the run ended (death | extracted | returned_empty | abandon | calcined),
  /// copied from GameSession.endReason.
  endReason String

  title        String
  bodyMarkdown String
  /// ChronicleMood (@grimoire/shared) stored as a plain string, matching
  /// Souvenir.type's convention — no Prisma enum in this schema.
  mood         String
  /// ChronicleKeyMoment[] sérialisé ({label, scene_ref}[]).
  keyMoments   Json
  tagline      String

  createdAt DateTime @default(now())
}
